# Copy to .env and edit:  cp .env.example .env     (never commit .env)

# ---------- MySQL / Spring Boot backend ----------
DB_URL=jdbc:mysql://localhost:3306/ai_weather?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=weather_app
DB_PASSWORD=change-me-now
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=
# Admin API stays DISABLED until a BCrypt hash is set. Create one with: bash scripts/hash_password.sh 'your-password'
# IMPORTANT: keep the hash inside SINGLE QUOTES (it contains '$' characters), e.g.
# ADMIN_PASSWORD_BCRYPT='$2a$10$....'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_BCRYPT=''
FORECAST_CACHE_TTL_MINUTES=30
SNAPSHOT_RETENTION_DAYS=90
RATE_LIMIT_PER_MINUTE=120
# Screening thresholds (see docs/model-methodology.md; verify against current IMD documents)
RISK_MODERATE_DAILY_MM=15.6
RISK_HIGH_DAILY_MM=64.5
RISK_VERY_HIGH_DAILY_MM=115.6
RISK_HIGH_HOURLY_MM=30
RISK_MIN_PROBABILITY_PCT=40

# ---------- Python ML service ----------
ML_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
ML_MODELS_DIR=
# must equal ML_SERVICE_API_KEY above if you set one

# ---------- Frontend (copy to frontend/.env.local) ----------
VITE_API_BASE_URL=http://localhost:8080/api/v1
